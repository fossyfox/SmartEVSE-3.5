# Copy to `.env` to configure the dev server / build.

# --- Development (vite dev server) -----------------------------------------
# Forward SmartEVSE HTTP + WebSocket requests through the Vite dev proxy to a
# real device. Avoids browser CORS during development: leave the in-app host
# field EMPTY and all requests are proxied to this host.
# VITE_DEVICE_HOST=192.168.1.50
# VITE_DEVICE_HOST=SmartEVSE-1234.local

# Host pre-filled in the connection field on first load.
# VITE_DEFAULT_HOST=SmartEVSE-1234.local

# Polling interval in milliseconds (default 5000).
# VITE_POLL_INTERVAL=5000

# --- Production behind the bundled proxy (npm run serve) -------------------
# Build with proxy mode so the app routes every request same-origin and passes
# the chosen device via the `X-Device-Host` header (no browser CORS).
# Set automatically by `npm run build:proxy`.
# VITE_PROXY_MODE=true
# VITE_PROXY_BASE=

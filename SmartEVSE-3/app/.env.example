# Copy to `.env` to configure the dev server. These only affect `npm run dev`;
# the production bundle (built into the firmware, served by the device) uses none
# of them.

# Forward SmartEVSE HTTP + WebSocket requests through the Vite dev proxy to a
# real device, so the browser hits one origin and CORS never applies. Leave the
# in-app host field EMPTY and all requests are proxied here.
# VITE_DEVICE_HOST=192.168.1.50
# VITE_DEVICE_HOST=SmartEVSE-1234.local

# Polling interval in milliseconds (default 5000).
# VITE_POLL_INTERVAL=5000

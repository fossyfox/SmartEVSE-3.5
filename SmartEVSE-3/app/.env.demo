# Loaded by `vite build --mode demo` (the `npm run build:demo` / Vercel build).
# Turns on the in-browser mock SmartEVSE so the deployed site is a self-contained
# demo with no real device — see src/lib/demo/. Not used by any other build.
VITE_DEMO=1

# Poll a little faster than the 5s default so the simulated dashboard feels live.
VITE_POLL_INTERVAL=2000

# Reverse proxy for the SmartEVSE UI in DEVELOPMENT.
#
# Same device-proxying as the production Caddyfile, but instead of serving a
# static ./dist it reverse-proxies the Vite dev server (HMR WebSocket included).
# So the browser talks to ONE origin (no CORS) while keeping hot reload:
#
#   browser ──▶ Caddy (:5173) ──┬─ /settings, /ws/lcd, … ─▶ device (DEVICE_HOST)
#                               └─ everything else ───────▶ Vite (localhost:5174)
#
# Both containers run on the host network (see docker-compose.yml), so requests
# to the device leave with the host's LAN IP — not a 172.x container address the
# device would refuse. That's also why the Vite upstream is reachable at
# localhost:5174 rather than a container DNS name.
{
	admin off
	auto_https off
}

:5173 {
	encode gzip zstd

	# --- Device endpoints (HTTP + LCD WebSocket) ---------------------------
	# Caught before the catch-all so they go to the controller, not Vite.
	@device path /settings /settings/* /reboot /update /update/* /mqtt_ca_cert /ocpp_ca_cert /lcd-verify-password /ws /ws/*
	handle @device {
		# Per-request device override sent by the app (proxy mode).
		@override header X-Device-Host *
		handle @override {
			reverse_proxy {http.request.header.X-Device-Host} {
				header_up Host {http.request.header.X-Device-Host}
				header_up -X-Device-Host
			}
		}
		# Default device from the DEVICE_HOST env. Used for the LCD WebSocket,
		# link navigations, and when no per-request override is sent.
		handle {
			reverse_proxy {$DEVICE_HOST:smartevse.local} {
				header_up Host {$DEVICE_HOST:smartevse.local}
			}
		}
	}

	# --- Vite dev server (app assets + HMR WebSocket) ----------------------
	# Host header is passed through unchanged (localhost:5173), which Vite
	# accepts. The HMR WebSocket upgrades at the root path, so it lands here,
	# not @device.
	handle {
		reverse_proxy localhost:5174
	}
}
